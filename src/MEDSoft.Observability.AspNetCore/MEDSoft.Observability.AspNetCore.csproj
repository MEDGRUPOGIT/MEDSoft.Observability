<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Version, TargetFramework e metadata comum: Directory.Build.props na
         raiz (lockstep com o nucleo — NAO redeclarar <Version> aqui). -->
    <PackageId>MEDSoft.Observability.AspNetCore</PackageId>
    <Description>Instrumentacao ASP.NET Core do MEDSoft.Observability (server spans + http.server metrics + filtro de health na origem). SO para apps web — e ela que exige imagem base `aspnet`. Worker referencia apenas o nucleo e roda em base `runtime` (issue #4). Mesma versao do nucleo, sempre (lockstep).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vira <dependency id="MEDSoft.Observability" version="X.Y.Z"/> no
         nuspec (piso >=, sem teto — pinar [X.Y.Z] exato criaria NU1107 em
         qualquer bump nao-simultaneo nos apps). A versao e lida do
         Directory.Build.props no momento do pack; o lockstep garante que
         nucleo e satelite saem sempre iguais. -->
    <ProjectReference Include="..\MEDSoft.Observability\MEDSoft.Observability.csproj" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicita por dois motivos: (1) o codigo daqui usa HttpContext
         (Filter); (2) documenta no NOSSO nuspec a exigencia de base `aspnet`,
         em vez de so herdar o frameworkReference transitivo que a
         Instrumentation.AspNetCore ja carrega. E exatamente ISTO que nao pode
         existir no nucleo — o motivo do split (issue #4). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
