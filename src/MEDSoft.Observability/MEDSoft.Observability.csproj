<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Version, TargetFramework e metadata comum de pacote: Directory.Build.
         props na raiz (versao unica do repo — NAO redeclarar <Version> aqui;
         o guard do publish barra a divergencia). -->
    <PackageId>MEDSoft.Observability</PackageId>
    <Description>OTel in-process compartilhado dos apps .NET do MEDSoft (ADR-041 do gitops-plataform): traces + metricas + logs via OTLP push pro alloy-receiver; service.name = workload k8s; sem sampler (o tail do coletor decide); ILogger-&gt;OTLP correlacionado. NUCLEO framework-neutro — worker roda em imagem base `runtime`; app web adiciona MEDSoft.Observability.AspNetCore (issue #4).</Description>
  </PropertyGroup>

  <!-- LINHA 1.17.0 (v0.3.0) — por que saiu do "1.14.x provado na frota":
       a auditoria de 2026-07-26 mediu que o pin era ficcao em runtime.
       1) PackageReference e PISO, nao trava: SqlClient 1.15.2 ja puxava
          OpenTelemetry.Api.ProviderBuilderExtensions 1.15.3 (set misto
          SILENCIOSO, sem NU1605), e os grafos dos apps resolviam acima —
          medido em prod: tagger com SDK 1.15.0, autorizacao exportando com
          UA OTel-OTLP-Exporter-Dotnet/1.16.0. "Provado 1.14.x" descrevia o
          csproj, nao o runtime.
       2) O exporter 1.14.0 carrega 3 CVEs medium (GHSA-4625-4j76-fww9,
          GHSA-mr8r-92fq-pj8p, GHSA-q834-8qmm-v933), todas corrigidas ate a
          1.15.3. Exposicao atual baixa (retry experimental off, gRPC), mas o
          bump fecha CVE + grafo misto de uma vez.
       3) 1.17.0 e a linha atual lancada em CONJUNTO (core + contribs) — o
          grafo resolve homogeneo. EFCore e StackExchangeRedis nao tem release
          estavel NENHUMA no NuGet (so betas): o warning NU5104 e inevitavel,
          nao um erro deste csproj.
       4) AWS 1.16.0 trouxe breaking de semconv (AWS 1.40) em atributos
          aws.*/cloud.region — sem consumidor medido hoje (zero span AWS
          observado na auditoria); revisar dashboards aws.* quando nascerem.
       Postgres e RabbitMQ 7 seguem SEM PackageReference: sao AddSource de
       sources nativos (ver comentarios no .cs). Npgsql.OpenTelemetry continua
       DELIBERADAMENTE evitado (arrastaria Npgsql fixo; apps divididos entre
       9 e 10 — os dois dialetos de metrica que isso gera sao tolerados pelas
       rules da plataforma desde gitops#776). -->
  <!-- SEM Instrumentation.AspNetCore DE PROPOSITO (issue #4, v0.4.0): ela
       carrega FrameworkReference Microsoft.AspNetCore.App no proprio nuspec,
       o que forcava TODO worker a imagem base `aspnet` (em `runtime` o shared
       framework nao existe e o app quebra no boot). O lado ASP.NET vive no
       satelite MEDSoft.Observability.AspNetCore; o build.yml tem guard que
       barra regressao (nuspec do nucleo nunca pode citar aspnetcore). -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AWS" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.17.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.17.0-beta.1" />
  </ItemGroup>

</Project>
